{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "opus",
  "effortLevel": "high",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(uv run python tools/verify.py)",
      "Bash(uv run python tools/verify.py *)",
      "Bash(uv run python tools/check_conventions.py)",
      "Bash(uv run python tools/check_conventions.py *)",
      "Bash(uv run python tools/check_guidance_integrity.py)",
      "Bash(uv run python tools/check_guidance_integrity.py *)",
      "Bash(uv run python tools/check_docs_sync.py *)",
      "Bash(uv run pytest *)",
      "Bash(uv run ruff *)",
      "Bash(uv run mypy *)",
      "Bash(uv run pre-commit run *)",
      "Bash(uv sync)",
      "Bash(uv sync *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)"
    ],
    "ask": [
      "Edit(CLAUDE.md)",
      "Edit(.claude/settings.json)",
      "Edit(.claude/settings.local.json)",
      "Edit(.claude/agents/**)",
      "Edit(.claude/hooks/**)",
      "Edit(.github/workflows/**)",
      "Edit(.pre-commit-config.yaml)",
      "Edit(.gitleaks.toml)",
      "Edit(pyproject.toml)",
      "Edit(docs/reference/fingerprint-spec.md)",
      "Edit(docs/reference/store-format.md)",
      "Bash(uv add *)",
      "Bash(uv remove *)",
      "Bash(uv publish *)",
      "Bash(git push *)",
      "Bash(git tag *)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(~/.pypirc)",
      "Read(~/.netrc)",
      "Read(~/.ssh/**)",
      "Agent(Explore)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --frozen --no-sync python \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/post_edit_check.py"
          }
        ]
      }
    ]
  }
}
